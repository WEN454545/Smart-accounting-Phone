# Force all text files to use UTF-8 encoding
* text=auto working-tree-encoding=UTF-8

# Source code files
*.java   text working-tree-encoding=UTF-8
*.kt     text working-tree-encoding=UTF-8
*.kts    text working-tree-encoding=UTF-8
*.xml    text working-tree-encoding=UTF-8
*.gradle text working-tree-encoding=UTF-8
*.properties text working-tree-encoding=UTF-8
*.pro    text working-tree-encoding=UTF-8
*.md     text working-tree-encoding=UTF-8
*.py     text working-tree-encoding=UTF-8
*.yml    text working-tree-encoding=UTF-8
*.yaml   text working-tree-encoding=UTF-8
*.json   text working-tree-encoding=UTF-8
*.bat    text working-tree-encoding=UTF-8
*.sh     text working-tree-encoding=UTF-8
*.txt    text working-tree-encoding=UTF-8

# Binary files
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.jar    binary
*.aar    binary
*.docx   binary
*.apk    binary
