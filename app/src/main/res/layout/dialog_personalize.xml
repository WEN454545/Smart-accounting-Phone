<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:background="@drawable/bg_dialog_rounded"
                android:text="\u2699"
                android:textSize="24sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="个性化设置"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置主页和日历的背景"
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Profile Background Option -->
        <LinearLayout
            android:id="@+id/opt_profile_bg"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_dialog_rounded"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:textSize="20sp"
                android:text="\ud83d\uddbc" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="个人主页背景"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设置头像区域的背景视频或图片"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=">"
                android:textSize="18sp"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- Login Background Option -->
        <LinearLayout
            android:id="@+id/opt_login_bg"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_dialog_rounded"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:textSize="20sp"
                android:text="\ud83d\udd12" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_login_bg"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_login_bg_subtitle"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=">"
                android:textSize="18sp"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- Home Background Option -->
        <LinearLayout
            android:id="@+id/opt_home_bg"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_dialog_rounded"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:textSize="20sp"
                android:text="\ud83c\udfe0" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_home_bg"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_home_bg_subtitle"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=">"
                android:textSize="18sp"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- Dialog Bill Background Option -->
        <LinearLayout
            android:id="@+id/opt_dialog_bill_bg"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_dialog_rounded"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:textSize="20sp"
                android:text="\ud83d\udcb0" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_dialog_bill_bg"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_dialog_bill_bg_subtitle"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=">"
                android:textSize="18sp"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- Calendar Background Option -->
        <LinearLayout
            android:id="@+id/opt_cal_bg"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_dialog_rounded"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:textSize="20sp"
                android:text="\ud83d\udcc5" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="日历网格背景"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="设置日历网格区域的背景图片"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=">"
                android:textSize="18sp"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- Cancel -->
        <TextView
            android:id="@+id/btn_personalize_cancel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="取消"
            android:textSize="14sp"
            android:textColor="@color/muted"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</androidx.cardview.widget.CardView>