<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header icon + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:background="@drawable/bg_dialog_rounded"
                android:text="&#x1F3A8;"
                android:textSize="22sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#x81EA;&#x5B9A;&#x4E49;&#x4E3B;&#x9875;&#x80CC;&#x666F;"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#x9009;&#x62E9;&#x4F60;&#x559C;&#x6B22;&#x7684;&#x80CC;&#x666F;&#x56FE;&#x7247;&#x6216;&#x89C6;&#x9891;"
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Preview area -->
        <FrameLayout
            android:id="@+id/fl_bg_preview"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_dialog_rounded"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/iv_preview_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_preview_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:background="#F0F4F8">

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_dialog_rounded" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#x9ED8;&#x8BA4;&#x80CC;&#x666F;"
                    android:textColor="@color/muted"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(&#x672A;&#x8BBE;&#x7F6E;&#x81EA;&#x5B9A;&#x4E49;&#x80CC;&#x666F;)"
                    android:textSize="11sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Choose button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_choose_bg"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="&#x9009;&#x62E9;&#x89C6;&#x9891;&#x6216;&#x56FE;&#x7247;"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@android:drawable/ic_menu_gallery"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

        <!-- Reset button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_bg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="&#x6062;&#x590D;&#x9ED8;&#x8BA4;"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/expense"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="@color/expense_bg"
            android:layout_marginTop="10dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

        <!-- Cancel text button -->
        <TextView
            android:id="@+id/btn_cancel_bg"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="&#x53D6;&#x6D88;"
            android:textSize="14sp"
            android:textColor="@color/muted"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
