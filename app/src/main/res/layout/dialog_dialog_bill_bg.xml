<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header icon + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:background="@drawable/bg_dialog_rounded"
                android:text="&#x1F4B0;"
                android:textSize="22sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_dialog_bill_bg_setting"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_dialog_bill_bg_subtitle"
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Preview area -->
        <FrameLayout
            android:id="@+id/fl_dialog_bill_bg_preview"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_dialog_rounded"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/iv_dialog_bill_bg_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ll_dialog_bill_bg_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@color/placeholder_bg">

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_dialog_rounded" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_bg_default"
                    android:textColor="@color/muted"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dialog_bill_bg_placeholder"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Choose image button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_bill_bg_choose"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/dialog_bill_bg_choose"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@android:drawable/ic_menu_gallery"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

        <!-- Reset button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_bill_bg_reset"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/profile_bg_reset"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/expense"
            app:cornerRadius="14dp"
            app:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:backgroundTint="@color/expense_bg"
            android:layout_marginTop="10dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton" />

        <!-- Cancel text button -->
        <TextView
            android:id="@+id/btn_dialog_bill_bg_cancel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="@string/cancel"
            android:textSize="14sp"
            android:textColor="@color/muted"
            android:background="?android:attr/selectableItemBackground"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</androidx.cardview.widget.CardView>