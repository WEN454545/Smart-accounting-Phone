<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_bill_title"
        android:textAlignment="center"
        android:textColor="@color/ink"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_expense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_tab_selected"
            android:backgroundTint="@color/expense_bg"
            android:text="@string/add_bill_expense"
            android:textColor="@color/expense"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_income"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/bg_tab_unselected"
            android:backgroundTint="@color/bg"
            android:text="@string/add_bill_income"
            android:textColor="@color/ink" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_bill_amount"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="14dp">

        <EditText
            android:id="@+id/input_amount"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:hint="@string/add_bill_amount_hint"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_currency"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_input"
            android:text="&#xA5;"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_bill_category"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/frame_category_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tv_selected_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&#x9910;&#x996E;"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end|center_vertical"
            android:src="@drawable/ic_dropdown_arrow"
            android:tint="@color/muted"
            android:alpha="0.6" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_bill_date"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/input_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input"
        android:hint="@string/add_bill_date_hint"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="false" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/add_bill_note"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/input_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input"
        android:hint="@string/add_bill_note_hint"
        android:padding="12dp"
        android:textColor="@color/ink"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_rounded"
            android:backgroundTint="@color/bg"
            android:text="@string/cancel_btn"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_selected"
            android:backgroundTint="?attr/colorPrimary"
            android:text="@string/add_bill_save"
            android:textColor="@android:color/white"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>