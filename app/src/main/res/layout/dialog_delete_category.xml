<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp"
    android:background="@drawable/bg_delete_dialog_rounded">

    <!-- Warning icon -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_delete_icon_circle">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="&#x26A0;"
            android:textSize="28sp"
            android:textColor="@android:color/white" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="&#x5220;&#x9664;&#x5206;&#x7C7B;"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/ink" />

    <!-- Message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="&#x786E;&#x8BA4;&#x8981;&#x5220;&#x9664;&#x4EE5;&#x4E0B;&#x5206;&#x7C7B;&#x5417;&#xFF1F;"
        android:textSize="13sp"
        android:textColor="@color/muted" />

    <!-- Category name highlight box -->
    <TextView
        android:id="@+id/tv_category_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_delete_category_name"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/expense"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="22dp">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:text="&#x53D6;&#x6D88;"
            android:textSize="14sp"
            android:textColor="@color/muted"
            android:background="@drawable/bg_delete_btn_cancel"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_confirm"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="&#x5220;&#x9664;"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_delete_btn_confirm"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
