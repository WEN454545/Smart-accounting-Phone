    <!-- AssistantManagerActivity 自启动引导 -->







    <string name="auto_start_guide_xiaomi">小米/红米自启动设置：\n1. 打开「手机管家」\n2. 点击「应用管理」→「权限」\n3. 找到「绝希」\n4. 开启「自启动」权限</string>







    <string name="auto_start_guide_huawei">华为/荣耀自启动设置：\n1. 打开「手机管家」\n2. 点击「应用启动管理」\n3. 找到「绝希」\n4. 关闭「自动管理」，允许自启动</string>







    <string name="auto_start_guide_oppo">OPPO自启动设置：\n1. 打开「手机管家」\n2. 点击「权限隐私」→「自启动管理」\n3. 找到「绝希」并开启</string>







    <string name="auto_start_guide_vivo">vivo自启动设置：\n1. 打开「i管家」\n2. 点击「应用管理」→「权限管理」\n3. 找到「绝希」\n4. 开启「自启动」</string>







    <string name="auto_start_guide_samsung">三星自启动设置：\n1. 打开「智能管理器」\n2. 点击「电池」→「应用程序管理」\n3. 找到「绝希」\n4. 关闭「使应用程序进入休眠」</string>







    <string name="auto_start_guide_other">请在手机设置中搜索「自启动」或「启动管理」\n找到「绝希」并开启自启动权限\n\n如找不到，请在「电池」或「应用管理」中查找</string>







